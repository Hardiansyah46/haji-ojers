Options +FollowSymLinks
RewriteEngine On
RewriteBase /

# ✅ Jangan rewrite kalau file atau folder memang ada
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Hilangkan index.php dari URL
RewriteCond %{THE_REQUEST} /index\.php [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Homepage dengan pagination
RewriteRule ^page/([0-9]+)/?$ index.php?page=home&hal=$1 [L,QSA]
RewriteRule ^$ index.php?page=home [L,QSA]

# Produk: /produk/slug-produk
RewriteRule ^produk/([a-zA-Z0-9_-]+)/?$ index.php?page=produk&slug=$1 [L,QSA]

# Artikel kategori + slug (contoh: /olahraga/malut-united-menang)
RewriteRule ^(olahraga|opini|berita)/([a-zA-Z0-9_-]+)/?$ index.php?page=artikel&category=$1&slug=$2 [L,QSA]


# Halaman kategori tanpa slug (contoh: /olahraga)
RewriteRule ^(olahraga|opini|berita)/?$ index.php?page=$1 [L,QSA]

# Search
RewriteRule ^search/?$ index.php?page=search [L,QSA]

# About, Contact, Privacy Policy
RewriteRule ^about/?$ index.php?page=about [L,QSA]
RewriteRule ^contact-us/?$ index.php?page=contact-us [L,QSA]
RewriteRule ^privacy-policy/?$ index.php?page=privacy-policy [L,QSA]

# Default fallback -> index.php
RewriteRule ^(.+)$ index.php?page=$1 [L,QSA]
